{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "wordpress-plugin-boilerplate/example",
  "version": "1.0.0",
  "title": "Latest items",
  "category": "widgets",
  "icon": "portfolio",
  "description": "Shows the latest items. Rendered in PHP (render.php), so it always shows current content.",
  "keywords": [
    "items",
    "list"
  ],
  "textdomain": "wordpress-plugin-boilerplate",
  "attributes": {
    "count": {
      "type": "number",
      "default": 3
    },
    "layout": {
      "type": "string",
      "enum": [
        "grid",
        "list"
      ],
      "default": "grid"
    }
  },
  "supports": {
    "html": false,
    "align": [
      "wide",
      "full"
    ],
    "spacing": {
      "margin": true,
      "padding": true
    }
  },
  "editorScript": "file:./index.js",
  "style": "file:./style-index.css",
  "render": "file:./render.php"
}